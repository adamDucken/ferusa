{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferusa",
  "version": "0.1.0",
  "identifier": "com.ferusa.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ferusa",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "script-src-attr": ["'none'"],
        "style-src": ["'self'"],
        "style-src-attr": ["'none'"],
        "img-src": ["'self'"],
        "font-src": ["'self'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "media-src": ["'none'"],
        "worker-src": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'unsafe-eval'", "http://localhost:1420"],
        "script-src-attr": ["'none'"],
        "style-src": ["'self'", "'unsafe-inline'", "http://localhost:1420"],
        "img-src": ["'self'", "data:", "blob:", "http://localhost:1420"],
        "font-src": ["'self'", "data:", "http://localhost:1420"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:1420",
          "ws://localhost:1421"
        ],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "media-src": ["'none'"],
        "worker-src": ["'self'", "blob:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
